{
	"$schema": "https://turbo.build/schema.json",
	"ui": "stream",
	"globalDependencies": [".env"],
	"globalEnv": [
		"NODE_ENV",
		"DATABASE_URL",
		"DATABASE_URL_UNPOOLED",
		"CLERK_SECRET_KEY",
		"NEXT_PUBLIC_*"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "public/sw.js"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"outputs": []
		},
		"test:coverage": {
			"outputs": ["coverage/**"]
		}
	}
}
