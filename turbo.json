{
	"$schema": "https://turbo.build/schema.json",
	"ui": "stream",
	"globalDependencies": [".env"],
	"globalEnv": [
		"NODE_ENV",
		"DATABASE_URL",
		"DATABASE_URL_UNPOOLED",
		"AUTH_SECRET",
		"AUTH_GOOGLE_ID",
		"AUTH_GOOGLE_SECRET",
		"ALLOWED_EMAIL_DOMAIN",
		"DATA_WAREHOUSE_URL",
		"LINEAR_API_KEY",
		"FEEDBACK_DRY_RUN"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "public/sw.js"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"outputs": []
		},
		"test:coverage": {
			"outputs": ["coverage/**"]
		}
	}
}
