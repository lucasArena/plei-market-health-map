{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [":NODE:", ":PACKAGE:", ":ALIAS:", ":PATH:"]
					}
				}
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "warn"
			},
			"complexity": {
				"noBannedTypes": "warn"
			},
			"style": {
				"noNonNullAssertion": "warn",
				"useImportType": "error",
				"useNodejsImportProtocol": "error"
			},
			"correctness": {
				"noUnusedFunctionParameters": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/core/src/domain/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@core/application/**",
											"@core/i18n/**",
											"@server/**",
											"@/**",
											"next",
											"next/**",
											"react",
											"react/**",
											"hono",
											"hono/**",
											"@prisma/**",
											"pg",
											"@market-health-map/**"
										],
										"message": "The domain layer depends on nothing: no application, i18n, apps or frameworks."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/core/src/application/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@core/i18n/**",
											"@server/**",
											"@/**",
											"next",
											"next/**",
											"react",
											"react/**",
											"hono",
											"hono/**",
											"@prisma/**",
											"pg",
											"@market-health-map/**"
										],
										"message": "The application layer depends only on the domain: no i18n, apps or frameworks."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/core/src/i18n/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@core/application/**",
											"@core/domain/**",
											"@server/**",
											"@/**",
											"next",
											"next/**",
											"react",
											"react/**",
											"hono",
											"hono/**",
											"@prisma/**",
											"pg",
											"@market-health-map/**"
										],
										"message": "i18n is standalone: no domain, application, apps or frameworks."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}", "**/testing/**/*.{ts,tsx}"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off",
						"noConfusingVoidType": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"files": {
		"includes": [
			"**/*.{js,jsx,ts,tsx,json}",
			"!**/node_modules",
			"!**/dist",
			"!**/build",
			"!**/.turbo",
			"!**/coverage",
			"!**/.nyc_output",
			"!**/drizzle",
			"!**/*.tsbuildinfo",
			"!**/.cache",
			"!**/.next",
			"!**/.nuxt",
			"!**/.vercel",
			"!**/.serverless",
			"!**/.pnpm-store",
			"!**/.local",
			"!**/public",
			"!**/lib/graphql/generated",
			"!next-env.d.ts",
			"!**/.turbo",
			"!**/src/**/generated",
			"!**/public/sw.js",
			"!**/public/swe-worker-*.js",
			"!**/next-env.d.ts",
			"!**/public/maplibre"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
